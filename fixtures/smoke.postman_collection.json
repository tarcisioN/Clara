{
  "info": {
    "_postman_id": "clara-fixture-001",
    "name": "Clara Smoke Collection",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health",
      "auth": {
        "type": "apikey",
        "apikey": [
          {
            "key": "key",
            "value": "X-Health-Key",
            "type": "string"
          },
          {
            "key": "value",
            "value": "folder-secret",
            "type": "string"
          },
          {
            "key": "in",
            "value": "header",
            "type": "string"
          }
        ]
      },
      "item": [
        {
          "name": "Ping",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.variables.set(\"pingStarted\", Date.now());",
                  ""
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", function () {",
                  "  pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "description": "kept by Clara"
              },
              {
                "key": "X-Debug",
                "value": "1",
                "disabled": true
              }
            ],
            "url": {
              "raw": "https://example.com/ping?verbose=1",
              "protocol": "https",
              "host": ["example", "com"],
              "path": ["ping"],
              "query": [
                {
                  "key": "verbose",
                  "value": "1"
                },
                {
                  "key": "trace",
                  "value": "1",
                  "disabled": true
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Root echo",
      "request": {
        "method": "POST",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "echo-token",
              "type": "string"
            }
          ]
        },
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\"ok\":true}",
          "options": {
            "raw": {
              "language": "json"
            }
          },
          "urlencoded": [
            {
              "key": "legacy",
              "value": "kept-when-mode-is-raw",
              "disabled": true
            }
          ]
        },
        "url": "https://example.com/echo"
      }
    },
    {
      "name": "Form login",
      "request": {
        "method": "POST",
        "auth": {
          "type": "basic",
          "basic": [
            {
              "key": "username",
              "value": "clara",
              "type": "string"
            },
            {
              "key": "password",
              "value": "secret",
              "type": "string"
            }
          ]
        },
        "header": [],
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            {
              "key": "user",
              "value": "clara"
            },
            {
              "key": "remember",
              "value": "1",
              "disabled": true
            }
          ],
          "raw": "{\"note\":\"sibling raw kept\"}"
        },
        "url": {
          "raw": "https://example.com/login",
          "protocol": "https",
          "host": ["example", "com"],
          "path": ["login"]
        }
      }
    }
  ]
}

{
  "name": "clara",
  "productName": "Clara",
  "version": "0.1.0",
  "private": true,
  "description": "Lightweight Postman collection editor for collections versioned in git",
  "author": "Clara contributors",
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "package": "npm run build && electron-builder --mac --dir",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "check:stage0": "node --experimental-strip-types scripts/check-stage0.ts",
    "check:stage1": "node --experimental-strip-types scripts/check-stage1.ts",
    "check:stage2": "node --experimental-strip-types scripts/check-stage2.ts",
    "check:stage3": "node --experimental-strip-types scripts/check-stage3.ts",
    "check:stage4": "node --experimental-strip-types scripts/check-stage4.ts",
    "check:stage5": "node --experimental-strip-types scripts/check-stage5.ts",
    "check:stage6": "node --experimental-strip-types scripts/check-stage6.ts",
    "check:stage7": "node --experimental-strip-types scripts/check-stage7.ts",
    "check:stage8": "node --experimental-strip-types scripts/check-stage8.ts",
    "check:stage9": "node --experimental-strip-types scripts/check-stage9.ts",
    "check:stage10": "node --experimental-strip-types scripts/check-stage10.ts",
    "check:stage11": "node --experimental-strip-types scripts/check-stage11.ts",
    "check:stage12": "node --experimental-strip-types scripts/check-stage12.ts",
    "check:stage13": "node --experimental-strip-types scripts/check-stage13.ts",
    "check:stage14": "node --experimental-strip-types scripts/check-stage14.ts",
    "check:stage15": "node --experimental-strip-types scripts/check-stage15.ts",
    "check:stage16": "node --experimental-strip-types scripts/check-stage16.ts",
    "check:stage17": "node --experimental-strip-types scripts/check-stage17.ts",
    "check:stage18": "node --experimental-strip-types scripts/check-stage18.ts",
    "check:stage19": "node --experimental-strip-types scripts/check-stage19.ts"
  },
  "dependencies": {
    "@codemirror/lang-javascript": "^6.2.5",
    "@uiw/react-codemirror": "^4.25.11",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "electron": "^37.2.0",
    "electron-builder": "^26.15.3",
    "typescript": "^5.8.3",
    "vite": "^7.0.4",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6"
  }
}
